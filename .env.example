# Copy this file to .env in the repository root. Keep actual values private.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Settings > API Keys > secret key (sb_secret_...), for Python server use only.
SUPABASE_SECRET_KEY=

# M4: Groq default; confirm account is Free (the app cannot verify billing tier).
# Live API still requires explicit enable. No paid-provider fallback.
COLLECTIONS_LLM_ENABLED=false
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_FREE_ONLY=true
GROQ_API_KEY=

# Local POC caps (reset with Python; not account/public-site billing controls).
LLM_MAX_CALLS_PER_RUN=4
LLM_MAX_CALLS_PER_PROCESS=20
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# Optional paid adapter only; never used unless selected AND FREE_ONLY=false.
OPENAI_API_KEY=

# Live project test email off by default; keep Resend account Free.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional legacy operator API only; not needed for the website Send email button.
EMAIL_OWNER_TOKEN=
EMAIL_FROM=onboarding@resend.dev
# Your own Resend signup email; never a sample customer's address.
EMAIL_TEST_RECIPIENT=
# Your unique account subdomain, e.g. abc123.resend.app (no @ or username).
EMAIL_RECEIVING_DOMAIN=

# M6 cloud mode: local learning can leave false; Render must set true.
PUBLIC_DEMO=false
# Private random secret32+characters for signed browser cookies.
DEMO_SESSION_SECRET=
